{
  "name": "reelforge-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "ReelForge: voice + YAML to finished vertical explainer videos. Offline, deterministic, no AI.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reelforge": "packages/cli/bin/reelforge.js"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -b packages/cli packages/studio && tsc -p packages/runtime/tsconfig.json --noEmit && tsc -p packages/studio/tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --project unit --coverage",
    "lint": "eslint . && prettier --check \"**/*.{ts,json,yaml,md}\" --log-level warn",
    "format": "prettier --write \"**/*.{ts,json,yaml,md}\"",
    "licenses": "node scripts/check-licenses.mjs",
    "reelforge": "node packages/cli/bin/reelforge.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@reelforge/audio": "workspace:*",
    "@reelforge/cli": "workspace:*",
    "@reelforge/core": "workspace:*",
    "@reelforge/renderer": "workspace:*",
    "@reelforge/runtime": "workspace:*",
    "@reelforge/studio": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "happy-dom": "18.0.1",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "3.2.4"
  }
}
