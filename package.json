{
  "name": "reelforge-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "ReelForge: voice + YAML to finished vertical explainer videos. Deterministic, no AI in the render engine; optional local speech alignment and scene suggestions.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reelforge": "packages/cli/bin/reelforge.js"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -b packages/cli packages/studio && tsc -p packages/runtime/tsconfig.json --noEmit && tsc -p packages/studio/tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --project unit --coverage",
    "lint": "eslint . && prettier --check \"**/*.{ts,json,yaml,md}\" --log-level warn && node scripts/check-mojibake.mjs && node scripts/check-skills.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "format": "prettier --write \"**/*.{ts,json,yaml,md}\"",
    "check:licenses": "node scripts/check-licenses.mjs",
    "reelforge": "node packages/cli/bin/reelforge.js",
    "docs": "node scripts/gen-docs.mjs && node scripts/build-docs.mjs && node scripts/build-docs-site.mjs",
    "docs:gen": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/check-docs-fresh.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:site": "vitepress build docs",
    "docs:local": "node scripts/build-docs-site.mjs",
    "docs:llms": "node scripts/gen-llms.mjs",
    "release": "node scripts/release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "marketing": "node scripts/marketing.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@reelforge/assist": "workspace:*",
    "@reelforge/audio": "workspace:*",
    "@reelforge/cli": "workspace:*",
    "@reelforge/core": "workspace:*",
    "@reelforge/renderer": "workspace:*",
    "@reelforge/runtime": "workspace:*",
    "@reelforge/studio": "workspace:*",
    "@types/node": "22.19.1",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "happy-dom": "20.14.6",
    "marked": "15.0.12",
    "pixelmatch": "7.1.0",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitepress": "1.6.4",
    "vitest": "4.1.12",
    "ws": "8.21.3"
  },
  "author": "Idriss Boukmouche"
}
