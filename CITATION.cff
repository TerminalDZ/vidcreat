    family-names: Boukmouche
    email: boukemoucheidriss@gmail.com
version: 1.0.0
date-released: '2026-11-01'
license: Apache-2.0
repository-code: 'https://github.com/TerminalDZ/vidcreat'
url: 'https://terminaldz.github.io/vidcreat'
keywords:
  - video
  - explainer video
  - vertical video
  - captions
  - deterministic rendering
  - speech alignment
