  },
  "bugs": {
    "url": "https://github.com/TerminalDZ/vidcreat/issues"
  },
  "keywords": [
    "reelforge",
    "video",
    "animation",
    "svg",
    "dom",
    "deterministic-rendering",
    "motion-graphics"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
