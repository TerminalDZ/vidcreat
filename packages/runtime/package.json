  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/cairo": "5.2.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource-variable/readex-pro": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@reelforge/audio": "workspace:*",
    "@reelforge/core": "workspace:*",
    "esbuild": "0.28.1",
    "lucide-static": "1.66.0"
