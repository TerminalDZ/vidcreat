  "homepage": "https://terminaldz.github.io/vidcreat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerminalDZ/vidcreat.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/TerminalDZ/vidcreat/issues"
  },
  "keywords": [
    "reelforge",
    "video-editor",
    "timeline-editor",
    "local-server",
    "dashboard"
  ],
  "type": "module",
  "main": "./dist/server/index.js",
