  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && vite build"
  },
  "dependencies": {
    "@reelforge/assist": "workspace:*",
    "@reelforge/audio": "workspace:*",
    "@reelforge/core": "workspace:*",
    "@reelforge/renderer": "workspace:*",
    "@reelforge/runtime": "workspace:*",
    "ws": "8.21.3",
    "yaml": "2.8.4",
    "zod": "4.6.7",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "vite": "6.4.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
