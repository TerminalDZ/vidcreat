    "directory": "packages/assist"
  },
  "bugs": {
    "url": "https://github.com/TerminalDZ/vidcreat/issues"
  },
  "keywords": [
    "reelforge",
    "speech-alignment",
    "forced-alignment",
    "voice-activity-detection",
    "subtitles",
    "offline"
